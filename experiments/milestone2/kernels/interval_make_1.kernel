# An interval from two values of T supplied by the program, guarded (rule R3): [lo, hi] when
# lo <= hi, lo < +inf and hi > -inf; the whole line when a bound is a NaN (decided on
# 2026-11-20: a NaN says that something failed upstream, and the empty set must not come out of
# that); the empty set otherwise, that is for lo > hi, [+inf, +inf] and [-inf, -inf].
kernel:        interval_make_1
input:         lo
input:         hi
output:        zl
output:        zu
status:        unverified
domain:        extended
ieee_status:   unverified
entry:         yes
ieee_only:     yes
cone_exempt:   both outputs are selected after explicit tests of the bounds

gl = guard(lo)
gu = guard(hi)
ok = le(gl, gu)
nl = lt(gl, const inf)
mi = neg(const inf)
nu = lt(mi, gu)
va = and(ok, nl)
v  = and(va, nu)
ql = eq(gl, gl)
qu = eq(gu, gu)
nn = and(ql, qu)
el = select(nn, const inf, mi)
eu = select(nn, mi, const inf)
zl = select(v, gl, el)
zu = select(v, gu, eu)
