# The smallest interval with one-limb bounds that contains a ball with a one-limb center:
# [RD(c - r), RU(c + r)]. The whole line (0, +inf) gives [-inf, +inf] by the same two operations;
# the empty set (all NaN) is selected.
kernel:        ball_to_interval_1
input:         stored c
input:         stored r
output:        zl
output:        zu
status:        unverified
domain:        extended
ieee_status:   unverified
entry:         yes
ieee_only:     yes
cone_exempt:   the bounds are directed sums, and the empty set is selected after an explicit test

l  = sub_down_1(c, r)
h  = add_up_1(c, r)
ne = eq(r, r)
mi = neg(const inf)
zl = select(ne, l, const inf)
zu = select(ne, h, mi)
