# The radius of the sum of two BallVectors with 2-limb centers: the radius lines of ball_add_2,
# with the largest |cz0| over the entries (mz) in place of one entry's. The formula does not
# decrease when mz grows, so the result is the largest of the radii that ball_add_2 returns
# entry by entry.
kernel:        bv_add_radius_2
input:         stored mz
input:         stored rx
input:         stored ry
output:        rz
min_precision: 3
status:        unverified
entry:         yes

s  = add(rx, ry)
t  = fma(mz, const up(unit(add_2_2)/(1-unit(add_2_2))*(1+u)), s)
rz = fma(t, const up((1+u)^3), const up((1+u)*((1+u)^2*eta+eta/2)+eta/(2*u)))
