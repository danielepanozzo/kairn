# The product of two 2-limb numbers with a bound d of its own error: |z - x y| <= d. d is the
# radius that ball_mul_2 returns for radii zero, with the same three constants E, G, H: there
# p, q and w are zero and t = fma(az, E, 0), which is prod(az, E).
kernel:        mul_ball_2_2
input:         x = x0 x1
input:         y = y0 y1
output:        z = z0 z1
output:        d
value:         x*y
requires:      normalized x
requires:      normalized y
min_precision: 4
status:        unverified

(z0, z1) = mul_2_2(x0, x1, y0, y1)
az       = abs(z0)
t        = prod(az, const up(unit(mul_2_2)/(1-unit(mul_2_2))))
d        = fma(t, const up((1+u)^6), const up((1+u)*(2*(1+u)^5*eta+tiny(mul_2_2)/(1-unit(mul_2_2))+eta/2)+eta/(2*u)))
