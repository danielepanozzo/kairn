# A ball with a one-limb center times a positive power of two c: exact whenever nothing
# underflows (ball_mul_pow2_2, with one limb).
kernel:        ball_mul_pow2_1
input:         stored cx
input:         stored rx
input:         c
output:        cz
output:        rz
value:         cx*c
requires:      nonneg rx
requires:      power_of_two c
status:        unverified
entry:         yes
cone_exempt:   the radius is selected and stepped; the special states of the ball layer test the center and the radius

cz = prod(cx, c)
rr = prod(rx, c)
am = abs(cz)
bc = lt(const up(eta/(2*u)), am)
zc = eq(cx, 0)
ec = or(bc, zc)
br = lt(const up(eta/(2*u)), rr)
zr = eq(rx, 0)
er = or(br, zr)
ex = and(ec, er)
su = succ(rr)
sw = add(su, const up(eta))
rw = succ(sw)
rz = select(ex, rr, rw)
