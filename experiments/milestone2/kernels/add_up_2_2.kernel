# A normalized pair that is at least x + y: as add_down_2_2, with the second limb moved up. The
# bound is zero when the computed sum is zero, for the same reason.
kernel:        add_up_2_2
input:         x = x0 x1
input:         y = y0 y1
output:        h = h0 h1
value:         x+y
requires:      normalized x
requires:      normalized y
status:        unverified
cone_exempt:   through add_up_1 and two_sum_ord, which select; the interval kernels test h0

(z0, z1, d) = add_ball_2_2(x0, x1, y0, y1)
zd          = eq(z0, 0)
dd          = select(zd, 0, d)
w           = add_up_1(z1, dd)
(h0, h1)    = two_sum_ord(z0, w)
