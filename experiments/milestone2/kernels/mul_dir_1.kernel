# Both directed products from one TwoProd, with 0 x = 0 for every x, an infinite x included: the
# endpoint product of interval arithmetic.
kernel:        mul_dir_1
input:         a
input:         b
output:        d
output:        v
value:         a*b
status:        unverified
cone_exempt:   d and v are p, a neighbor of p or zero, chosen by select

(p, e) = two_prod(a, b)
ap     = abs(p)
bd     = lt(ap, const up(eta/(2*u^2)))
ez     = eq(e, 0)
un     = and(bd, ez)
n      = lt(e, 0)
sd     = or(n, un)
pp     = pred(p)
dz     = select(sd, pp, p)
q      = lt(0, e)
su     = or(q, un)
sp     = succ(p)
vz     = select(su, sp, p)
za     = eq(a, 0)
zb     = eq(b, 0)
zz     = or(za, zb)
d      = select(zz, 0, dz)
v      = select(zz, 0, vz)
