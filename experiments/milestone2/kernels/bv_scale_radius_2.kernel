# The radius of a BallVector with 2-limb centers times a number a of T: the radius lines of
# ball_scale_2, with the largest |cz0| over the entries (mz) in place of one entry's.
kernel:        bv_scale_radius_2
input:         stored mz
input:         stored rx
input:         a
output:        rz
min_precision: 2
status:        unverified
entry:         yes

aa = abs(a)
p  = prod(aa, rx)
t  = fma(mz, const up(unit(mul_2_1)/(1-unit(mul_2_1))*(1+u)), p)
rz = fma(t, const up((1+u)^3), const up((1+u)*((1+u)^2*eta+tiny(mul_2_1)/(1-unit(mul_2_1))+eta/2)+eta/(2*u)))
