# Proposed (milestone2.md, "BallVector": bv_mul_pow2_k): the step of bv_mul_pow2_1, the center scaled
# (mul_pow2_step_1) and the mask that the scaling was exact, ec of ball_mul_pow2_1 (bv_mul_pow2_step_2,
# bv_proposals.py).
kernel:        bv_mul_pow2_step_1
input:         stored x
input:         c
output:        z
output:        mask e
status:        unverified
entry:         yes

z  = prod(x, c)
am = abs(z)
bc = lt(const up(eta/(2*u)), am)
zc = eq(x, 0)
e  = or(bc, zc)
