# A ball with a 2-limb center times a positive power of two c: exact whenever nothing underflows.
# The center is scaled as mul_pow2_2 does. When the scaled last nonzero limb of the center is
# above the smallest normal number N = eta / (2u) (or the center is zero) and so is the scaled
# radius (or the radius is zero), both scalings are exact and the radius is c rx itself.
# Otherwise the radius is the number after RN(succ(RN(c rx)) + eta), which covers the eta that the
# center may have lost.
kernel:        ball_mul_pow2_2
input:         cx = cx0 cx1
input:         stored rx
input:         c
output:        cz = cz0 cz1
output:        rz
value:         cx*c
requires:      normalized cx
requires:      nonneg rx
requires:      power_of_two c
status:        unverified
entry:         yes
cone_exempt:   the radius is selected and stepped; the special states of the ball layer test the center and the radius

h          = prod(cx0, c)
l          = prod(cx1, c)
(cz0, cz1) = fast_two_sum(h, l)
rr         = prod(rx, c)
ze         = eq(cx1, 0)
m          = select(ze, h, l)
am         = abs(m)
bc         = lt(const up(eta/(2*u)), am)
zc         = eq(cx0, 0)
ec         = or(bc, zc)
br         = lt(const up(eta/(2*u)), rr)
zr         = eq(rx, 0)
er         = or(br, zr)
ex         = and(ec, er)
su         = succ(rr)
sw         = add(su, const up(eta))
rw         = succ(sw)
rz         = select(ex, rr, rw)
