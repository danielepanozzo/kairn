# RD(a + b): the rounded sum, one step down when its exact error is negative.
kernel:        add_down_1
input:         a
input:         b
output:        r
value:         a+b
status:        unverified
cone_exempt:   r is s or pred(s), chosen by select

(s, e) = two_sum_ord(a, b)
n      = lt(e, 0)
p      = pred(s)
r      = select(n, p, s)
