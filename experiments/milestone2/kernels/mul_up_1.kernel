# An upper bound of a b: RU(a b) when a b = 0 or |a b| >= 2^(2p-1) eta; below that, RU(a b) or the
# number of the format after it.
kernel:        mul_up_1
input:         a
input:         b
output:        r
value:         a*b
status:        unverified
cone_exempt:   r is p or succ(p), chosen by select

(p, e) = two_prod(a, b)
ap     = abs(p)
bd     = lt(ap, const up(eta/(2*u^2)))
ez     = eq(e, 0)
un     = and(bd, ez)
n      = lt(0, e)
su     = or(n, un)
sp     = succ(p)
v      = select(su, sp, p)
za     = eq(a, 0)
zb     = eq(b, 0)
zz     = or(za, zb)
r      = select(zz, p, v)
