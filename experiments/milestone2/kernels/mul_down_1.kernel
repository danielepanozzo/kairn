# A lower bound of a b: RD(a b) when a b = 0 or |a b| >= 2^(2p-1) eta; below that, RD(a b) or the
# number of the format before it. The constant is that threshold, eta / (2 u^2). A zero factor
# returns the rounded product itself (a zero, or the NaN of 0 times infinity).
kernel:        mul_down_1
input:         a
input:         b
output:        r
value:         a*b
status:        unverified
cone_exempt:   r is p or pred(p), chosen by select

(p, e) = two_prod(a, b)
ap     = abs(p)
bd     = lt(ap, const up(eta/(2*u^2)))
ez     = eq(e, 0)
un     = and(bd, ez)
n      = lt(e, 0)
sd     = or(n, un)
pp     = pred(p)
d      = select(sd, pp, p)
za     = eq(a, 0)
zb     = eq(b, 0)
zz     = or(za, zb)
r      = select(zz, p, d)
