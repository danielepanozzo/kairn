# RU(a + b): the rounded sum, one step up when its exact error is positive.
kernel:        add_up_1
input:         a
input:         b
output:        r
value:         a+b
status:        unverified
cone_exempt:   r is s or succ(s), chosen by select

(s, e) = two_sum_ord(a, b)
n      = lt(0, e)
q      = succ(s)
r      = select(n, q, s)
