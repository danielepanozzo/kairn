# Proposed (milestone2.md, "BallVector": bv_axpy_k): the one radius of a X + Y, the page's
# bv_add_radius_2(M, bv_scale_radius_2(M', rx, a), ry), M the largest leading magnitude of the centers
# written and M' that of the scaled centers (bv_axpy_step_2). Its claim would be bv_add_radius_2's with
# the claim of bv_scale_radius_2 in place of rx (bv_proposals.py).
kernel:        bv_axpy_radius_2
input:         stored m
input:         stored mp
input:         stored rx
input:         stored ry
input:         a
output:        rz
status:        unverified
entry:         yes

s  = bv_scale_radius_2(mp, rx, a)
rz = bv_add_radius_2(m, s, ry)
