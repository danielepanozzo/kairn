# The difference of two intervals with one-limb bounds: [xl - yu, xu - yl], outward.
kernel:        interval_sub_1
input:         stored xl
input:         stored xu
input:         stored yl
input:         stored yu
output:        zl
output:        zu
status:        unverified
domain:        extended
ieee_status:   unverified
entry:         yes
ieee_only:     yes
cone_exempt:   the bounds are directed differences, and the empty set is selected after an explicit test

l  = sub_down_1(xl, yu)
h  = sub_up_1(xu, yl)
nx = lt(xl, const inf)
ny = lt(yl, const inf)
ne = and(nx, ny)
mi = neg(const inf)
zl = select(ne, l, const inf)
zu = select(ne, h, mi)
