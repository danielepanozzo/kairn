# Test kernel: comparisons, mask logic, select, succ, pred, prod and a constant; every mask is
# made visible by a select.
kernel:   ops_masks
input:    a
input:    b
output:   r = r0 w1 w2 w3 w4 w5 w6 up dn g
value:    a+b
ensures:  error r R c=1 k=1 t=0
status:   unverified

m1 = lt(a, b)
m2 = le(b, a)
m3 = eq(a, b)
m4 = or(m3, m1)
m5 = not(m2)
m6 = and(m4, m5)
w1 = select(m1, a, b)
w2 = select(m2, a, b)
w3 = select(m3, a, b)
w4 = select(m4, a, b)
w5 = select(m5, a, b)
w6 = select(m6, a, b)
up = succ(a)
dn = pred(b)
g  = prod(const splitter, a)
h  = add(g, b)
k1 = add(w1, w2)
k2 = add(w3, w4)
k3 = add(w5, w6)
k4 = sub(up, dn)
k5 = add(k1, k2)
k6 = add(k3, k4)
k7 = add(k5, k6)
r0 = add(h, k7)
