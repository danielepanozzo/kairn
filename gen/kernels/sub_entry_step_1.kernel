# The step of the map sub_1 on arrays that the program supplies: both operands pass through guard,
# rule R3, then sub_1_1. Its claims are those of sub_1_1.
kernel:        sub_entry_step_1
input:         x
input:         y
output:        z
value:         x-y
ensures:       rounded z nearest
ensures:       error z R c=1/(1+u) k=1 t=0
min_precision: 1
source:        sub_1_1 on guarded operands (rule R3); one rounding to nearest
license:       bound: published; proof: MIT
status:        unverified
entry:         yes

gx = guard(x)
gy = guard(y)
z  = sub_1_1(gx, gy)
