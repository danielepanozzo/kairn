# The step of the map sub_1 on arrays that the program supplies: both operands pass through guard,
# rule R3, then sub_1_1. Its claims are those of sub_1_1. Also x - y of Packed<T, 1>
# (kairn/packed.hpp), which calls it on its own.
kernel:        sub_entry_step_1
input:         x
input:         y
output:        z
value:         x-y
ensures:       rounded z nearest
ensures:       error z R c=1/(1+u) k=1 t=0
min_precision: 1
theorem:       proofs/theories/MapSteps.v sub_entry_step_1_correct
ieee_bridge_theorem: proofs/theories/IeeeMapSteps.v sub_entry_step_1_ieee_bridge
ieee_lead_theorem: proofs/theories/IeeeMapSteps.v sub_entry_step_1_ieee_lead
source:        sub_1_1 on guarded operands (rule R3); one rounding to nearest, the bound u/(1+u) of JR18
license:       bound: published; proof: MIT
status:        proved
entry:         yes
ieee:          bridge

gx = guard(x)
gy = guard(y)
z  = sub_1_1(gx, gy)
