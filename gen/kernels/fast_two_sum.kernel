# Fast2Sum: the same as TwoSum in three operations when |a| >= |b|; (s, e) is then normalized.
kernel:        fast_two_sum
input:         a
input:         b
output:        r = s e
value:         a+b
requires:      abs_ge a b
ensures:       leading_rounded r
ensures:       error r R c=0 k=2 t=0
ensures:       normalized r
min_precision: 2
theorem:       proofs/theories/FastTwoSum.v fast_two_sum_correct
source:        Fast2Sum (Dekker 1971)
license:       algorithm: published; proof: MIT
status:        unverified

s = add(a, b)
z = sub(s, a)
e = sub(b, z)
