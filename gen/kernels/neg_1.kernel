# The negation of a number of T: exact. The step of bv_neg_1, the negation of a BallVector with
# one-limb centers (milestone2.md, "BallVector": bv_neg_k), whose two-limb step is neg_2.
kernel:        neg_1
input:         x
output:        z
value:         -x
ensures:       rounded z nearest
min_precision: 1
theorem:       proofs/theories/BvNegMake.v neg_1_correct
ieee_bridge_theorem: proofs/theories/IeeeBvNegMake.v neg_1_ieee_bridge
ieee_lead_theorem: proofs/theories/IeeeBvNegMake.v neg_1_ieee_lead
source:        a change of sign (milestone2.md, BallVector, bv_neg_k)
license:       algorithm and proof: MIT
status:        proved
ieee:          bridge

z = neg(x)
