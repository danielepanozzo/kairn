# DWPlusFP: a double-word number plus a number of the format. The operand a enters from the
# program and is guarded in the first line (rule R3; milestone1.md, "Values that enter from the
# program"). Unverified until the proof of add_2_1_correct is attached to this listing.
kernel:        add_2_1
input:         x = x0 x1
input:         a
output:        z = z0 z1
value:         x+a
requires:      normalized x
ensures:       normalized z
ensures:       error z R c=2 k=2 t=0
min_precision: 3
theorem:       proofs/theories/Add21.v add_2_1_correct
source:        JMP17 Alg. 4 (DWPlusFP); bound from MR22
license:       algorithm: published; proof: MIT
status:        unverified
ieee:          bridge spec
ieee_finite:   abs_le(x0,-2);abs_le(a,-2)
ieee_finite_result: abs_le(x+a,-2)
entry:         yes

g        = guard(a)
(sh, sl) = two_sum(x0, g)
v        = add(x1, sl)
(z0, z1) = fast_two_sum(sh, v)
