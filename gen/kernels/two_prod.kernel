# TwoProd with an FMA. The rounded product is prod, an FMA with a zero addend, so that no compiler
# can contract it into the additions that consume it. Exact unless the product is tiny.
kernel:        two_prod
input:         a
input:         b
output:        r = p e
value:         a*b
ensures:       leading_rounded r
ensures:       error r R c=0 k=2 t=1/2
ensures:       error r R c=0 k=2 t=0 when=product_large
min_precision: 2
theorem:       proofs/theories/TwoProd.v two_prod_correct
source:        TwoProd with an FMA (folklore; see JMP17)
license:       algorithm: published; proof: MIT
status:        unverified
ce_variant:    two_prod_dekker

p = prod(a, b)
e = fms(a, b, p)
