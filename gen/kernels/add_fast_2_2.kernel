# SloppyDWPlusDW, ending with Fast2Sum. Whether the result is still normalized when the leading
# limbs cancel is settled by exhaustive tests (the alternative ending is add_fast_2_2_ts). The
# constant c is provisional.
kernel:        add_fast_2_2
input:         x = x0 x1
input:         y = y0 y1
output:        z = z0 z1
value:         x+y
requires:      normalized x
requires:      normalized y
ensures:       normalized z
ensures:       error z A c=4 k=2 t=0
theorem:       proofs/theories/AddFast22.v add_fast_2_2_correct
source:        JMP17 Alg. 5 (SloppyDWPlusDW)
license:       algorithm: published; proof: MIT
status:        unverified

(sh, sl) = two_sum(x0, y0)
v        = add(x1, y1)
w        = add(sl, v)
(z0, z1) = fast_two_sum(sh, w)
