# DWTimesFP3: a double-word number times a number of the format. The underflow term t is
# provisional: the smallest valid t is settled by exhaustive tests first.
kernel:        mul_2_1
input:         x = x0 x1
input:         a
output:        z = z0 z1
value:         x*a
requires:      normalized x
ensures:       normalized z
ensures:       error z R c=2 k=2 t=2
theorem:       proofs/theories/Mul21.v mul_2_1_correct
source:        JMP17 Alg. 9 (DWTimesFP3); bound from MR22
license:       algorithm: published; proof: MIT
status:        unverified

(ch, cl1) = two_prod(x0, a)
cl3       = fma(x1, a, cl1)
(z0, z1)  = fast_two_sum(ch, cl3)
