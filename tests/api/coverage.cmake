# Every kernel of gen/claims.json is computed by some public operation (runner --list), or is a
# building block of other kernels (runner --internal), or is an entry kernel that no public
# operation calls yet, with the reason (runner --not-public); and tests/api/CMakeLists.txt has the
# same two lists. An entry kernel (entry: yes in its description in gen/kernels, one the public
# headers may call with values from the program) can never be a building block: it is reached
# by a public form or it is on the short list. A kernel added to the generator fails here until
# someone decides which it is. The kernels of NOT_CHECKED, the lists KAIRN_NOT_YET_CROSS_CHECKED
# (the kernels the oracle does not judge yet) and KAIRN_NOT_PUBLIC_YET (the folds' stage of
# Milestone 2, judged by the oracle, whose public functions come later) of tests/CMakeLists.txt,
# are in none of the runner's lists, and no public operation calls them yet.
#
#   cmake -DRUNNER=... -DCLAIMS=gen/claims.json -DKERNELS=gen/kernels "-DINTERNAL=a;b"
#         "-DNOT_PUBLIC=c;d" "-DNOT_CHECKED=e;f" -P coverage.cmake
cmake_minimum_required(VERSION 3.21)

foreach(_what list internal not-public)
  execute_process(COMMAND "${RUNNER}" --${_what} OUTPUT_VARIABLE _out RESULT_VARIABLE _status)
  if(NOT _status STREQUAL "0")
    message(FATAL_ERROR "${RUNNER} --${_what} failed: ${_status}")
  endif()
  string(STRIP "${_out}" _out)
  string(REPLACE "\n" ";" _lines "${_out}")
  set(_names "")
  foreach(_line IN LISTS _lines)
    string(REGEX REPLACE "\t.*" "" _name "${_line}")
    if(_what STREQUAL "not-public" AND _name STREQUAL _line)
      message(FATAL_ERROR "runner --not-public: ${_name} has no reason beside it")
    endif()
    list(APPEND _names "${_name}")
  endforeach()
  list(SORT _names)
  string(REPLACE "-" "_" _var "${_what}")
  set(_runner_${_var} ${_names})
endforeach()

file(READ "${CLAIMS}" _json)
string(JSON _count LENGTH "${_json}" kernels)
math(EXPR _last "${_count} - 1")
set(_claims "")
foreach(_i RANGE ${_last})
  string(JSON _k GET "${_json}" kernels ${_i} name)
  list(APPEND _claims ${_k})
endforeach()

file(GLOB _descriptions "${KERNELS}/*.kernel")
set(_entry "")
foreach(_file IN LISTS _descriptions)
  file(STRINGS "${_file}" _lines REGEX "^(kernel|entry):")
  set(_name "")
  set(_is_entry OFF)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^kernel:[ \t]+([a-z0-9_]+)")
      set(_name "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^entry:[ \t]+yes")
      set(_is_entry ON)
    endif()
  endforeach()
  if(_is_entry)
    list(APPEND _entry ${_name})
  endif()
endforeach()
if(NOT _entry)
  message(FATAL_ERROR "no entry kernel found in ${KERNELS}: the scan is broken")
endif()

set(_problems "")
set(_internal ${INTERNAL})
set(_not_public ${NOT_PUBLIC})
list(SORT _internal)
list(SORT _not_public)
if(NOT _runner_internal STREQUAL _internal)
  list(APPEND _problems "internal in tests/api/CMakeLists.txt: ${_internal}; in tests/api/runner.cpp: ${_runner_internal}")
endif()
if(NOT _runner_not_public STREQUAL _not_public)
  list(APPEND _problems "not public in tests/api/CMakeLists.txt: ${_not_public}; in tests/api/runner.cpp: ${_runner_not_public}")
endif()
set(_not_checked ${NOT_CHECKED})
foreach(_k IN LISTS _not_checked)
  if(NOT _k IN_LIST _claims)
    list(APPEND _problems "${_k}, in none of the runner's lists (not cross-checked or not public yet), is not a kernel of ${CLAIMS}")
  endif()
endforeach()
foreach(_k IN LISTS _claims)
  set(_n 0)
  foreach(_group list internal not_public)
    if(_k IN_LIST _runner_${_group})
      math(EXPR _n "${_n} + 1")
    endif()
  endforeach()
  if(_k IN_LIST _not_checked)
    if(NOT _n EQUAL 0)
      list(APPEND _problems "${_k} is not cross-checked or not public yet, and in ${_n} of the runner's lists")
    endif()
    continue()
  endif()
  if(NOT _n EQUAL 1)
    list(APPEND _problems "${_k} is in ${_n} of the runner's lists (public forms, internal, not public), not in one")
  endif()
endforeach()
foreach(_group list internal not_public)
  foreach(_k IN LISTS _runner_${_group})
    if(NOT _k IN_LIST _claims)
      list(APPEND _problems "${_k}, in the runner's ${_group}, is not a kernel of ${CLAIMS}")
    endif()
  endforeach()
endforeach()
foreach(_k IN LISTS _entry)
  if(_k IN_LIST _not_checked)
    continue()          # the steps of the folds over arrays of the program: checked above
  endif()
  if(_k IN_LIST _runner_internal)
    list(APPEND _problems "${_k} is an entry kernel, but the runner lists it as a building block")
  elseif(NOT _k IN_LIST _runner_list AND NOT _k IN_LIST _runner_not_public)
    list(APPEND _problems "${_k} is an entry kernel that no public form reaches and that is not listed as not public yet")
  endif()
endforeach()
foreach(_k IN LISTS _runner_not_public)
  if(NOT _k IN_LIST _entry)
    list(APPEND _problems "${_k} is listed as not public yet, but it is not an entry kernel")
  endif()
endforeach()
if(_problems)
  string(JOIN "\n" _problems ${_problems})
  message(FATAL_ERROR "${_problems}")
endif()
list(LENGTH _runner_list _n)
list(LENGTH _runner_internal _m)
list(LENGTH _runner_not_public _p)
list(LENGTH _entry _e)
list(LENGTH _not_checked _q)
message(STATUS "${_n} kernels reached by public forms, ${_m} building blocks, ${_p} entry kernels not public yet "
  "(${_e} entry kernels in all), ${_q} kernels in none of the runner's lists (not cross-checked "
  "or not public yet)")
