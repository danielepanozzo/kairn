# Every kernel of gen/claims.json is computed by some public operation (runner --list), or is a
# building block of other kernels (runner --internal), or is an entry kernel that no public
# operation calls yet, with the reason (runner --not-public); and tests/api/CMakeLists.txt has the
# same two lists. An entry kernel (entry: yes in its description in gen/kernels, one the public
# headers may call with values from the program) can never be a building block: it is reached
# by a public form or it is on the short list. A kernel added to the generator fails here until
# someone decides which it is. The kernels of NOT_CHECKED, the lists KAIRN_NOT_YET_CROSS_CHECKED
# (the kernels the oracle does not judge yet) and KAIRN_NOT_PUBLIC_YET (kernels judged by the
# oracle whose public functions come later: those of the ball vectors, and the steps of the maps on
# stored arrays) of tests/CMakeLists.txt, are in none of the runner's lists, and no public
# operation calls them yet.
#
# With -DPACKED_HEADER=include/kairn/packed.hpp, also: the kernels that header calls (gen::NAME(
# with NAME a kernel of the claims) are exactly those that the runner's packed forms map to
# (runner --packed-list), and each is reached by a scalar public form too: every operation of
# Packed is judged, and judged against the claims of a kernel the scalar interface has.
#
# And every fold of gen/claims.json is reached by a form of the functions on arrays (runner
# --fold-list), or has no public caller, with the reason (runner --folds-not-public, the list
# FOLDS_NOT_PUBLIC), or is one of FOLDS_NOT_CHECKED: exactly one.
#
#   cmake -DRUNNER=... -DCLAIMS=gen/claims.json -DKERNELS=gen/kernels "-DINTERNAL=a;b"
#         "-DNOT_PUBLIC=c;d" "-DNOT_CHECKED=e;f" "-DFOLDS_NOT_PUBLIC=g;h" "-DFOLDS_NOT_CHECKED=i;j"
#         [-DPACKED_HEADER=...] -P coverage.cmake
cmake_minimum_required(VERSION 3.21)

set(_whats list internal not-public)
if(PACKED_HEADER)
  list(APPEND _whats packed-list)
endif()
foreach(_what IN LISTS _whats)
  execute_process(COMMAND "${RUNNER}" --${_what} OUTPUT_VARIABLE _out RESULT_VARIABLE _status)
  if(NOT _status STREQUAL "0")
    message(FATAL_ERROR "${RUNNER} --${_what} failed: ${_status}")
  endif()
  string(STRIP "${_out}" _out)
  string(REPLACE "\n" ";" _lines "${_out}")
  set(_names "")
  foreach(_line IN LISTS _lines)
    string(REGEX REPLACE "\t.*" "" _name "${_line}")
    if(_what STREQUAL "not-public" AND _name STREQUAL _line)
      message(FATAL_ERROR "runner --not-public: ${_name} has no reason beside it")
    endif()
    list(APPEND _names "${_name}")
  endforeach()
  list(SORT _names)
  string(REPLACE "-" "_" _var "${_what}")
  set(_runner_${_var} ${_names})
endforeach()

file(READ "${CLAIMS}" _json)
string(JSON _count LENGTH "${_json}" kernels)
math(EXPR _last "${_count} - 1")
set(_claims "")
foreach(_i RANGE ${_last})
  string(JSON _k GET "${_json}" kernels ${_i} name)
  list(APPEND _claims ${_k})
endforeach()

file(GLOB _descriptions "${KERNELS}/*.kernel")
set(_entry "")
foreach(_file IN LISTS _descriptions)
  file(STRINGS "${_file}" _lines REGEX "^(kernel|entry):")
  set(_name "")
  set(_is_entry OFF)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^kernel:[ \t]+([a-z0-9_]+)")
      set(_name "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^entry:[ \t]+yes")
      set(_is_entry ON)
    endif()
  endforeach()
  if(_is_entry)
    list(APPEND _entry ${_name})
  endif()
endforeach()
if(NOT _entry)
  message(FATAL_ERROR "no entry kernel found in ${KERNELS}: the scan is broken")
endif()

set(_problems "")
set(_internal ${INTERNAL})
set(_not_public ${NOT_PUBLIC})
list(SORT _internal)
list(SORT _not_public)
if(NOT _runner_internal STREQUAL _internal)
  list(APPEND _problems "internal in tests/api/CMakeLists.txt: ${_internal}; in tests/api/runner.cpp: ${_runner_internal}")
endif()
if(NOT _runner_not_public STREQUAL _not_public)
  list(APPEND _problems "not public in tests/api/CMakeLists.txt: ${_not_public}; in tests/api/runner.cpp: ${_runner_not_public}")
endif()
set(_not_checked ${NOT_CHECKED})
foreach(_k IN LISTS _not_checked)
  if(NOT _k IN_LIST _claims)
    list(APPEND _problems "${_k}, in none of the runner's lists (not cross-checked or not public yet), is not a kernel of ${CLAIMS}")
  endif()
endforeach()
foreach(_k IN LISTS _claims)
  set(_n 0)
  foreach(_group list internal not_public)
    if(_k IN_LIST _runner_${_group})
      math(EXPR _n "${_n} + 1")
    endif()
  endforeach()
  if(_k IN_LIST _not_checked)
    if(NOT _n EQUAL 0)
      list(APPEND _problems "${_k} is not cross-checked or not public yet, and in ${_n} of the runner's lists")
    endif()
    continue()
  endif()
  if(NOT _n EQUAL 1)
    list(APPEND _problems "${_k} is in ${_n} of the runner's lists (public forms, internal, not public), not in one")
  endif()
endforeach()
foreach(_group list internal not_public)
  foreach(_k IN LISTS _runner_${_group})
    if(NOT _k IN_LIST _claims)
      list(APPEND _problems "${_k}, in the runner's ${_group}, is not a kernel of ${CLAIMS}")
    endif()
  endforeach()
endforeach()
foreach(_k IN LISTS _entry)
  if(_k IN_LIST _not_checked)
    continue()          # the steps of the folds over arrays of the program: checked above
  endif()
  if(_k IN_LIST _runner_internal)
    list(APPEND _problems "${_k} is an entry kernel, but the runner lists it as a building block")
  elseif(NOT _k IN_LIST _runner_list AND NOT _k IN_LIST _runner_not_public)
    list(APPEND _problems "${_k} is an entry kernel that no public form reaches and that is not listed as not public yet")
  endif()
endforeach()
foreach(_k IN LISTS _runner_not_public)
  if(NOT _k IN_LIST _entry)
    list(APPEND _problems "${_k} is listed as not public yet, but it is not an entry kernel")
  endif()
endforeach()
# The folds (gen/claims.json, "folds"): each is reached by a form of the functions on arrays
# (runner --fold-list), or listed with why no public function calls it (runner --folds-not-public,
# the same list as FOLDS_NOT_PUBLIC), or is one of FOLDS_NOT_CHECKED (KAIRN_NOT_YET_CROSS_CHECKED_FOLDS
# and KAIRN_NOT_PUBLIC_YET_FOLDS of tests/CMakeLists.txt): exactly one of the three.
foreach(_what fold-list folds-not-public)
  execute_process(COMMAND "${RUNNER}" --${_what} OUTPUT_VARIABLE _out RESULT_VARIABLE _status)
  if(NOT _status STREQUAL "0")
    message(FATAL_ERROR "${RUNNER} --${_what} failed: ${_status}")
  endif()
  string(STRIP "${_out}" _out)
  string(REPLACE "\n" ";" _lines "${_out}")
  set(_names "")
  foreach(_line IN LISTS _lines)
    string(REGEX REPLACE "\t.*" "" _name "${_line}")
    if(_what STREQUAL "folds-not-public" AND _name STREQUAL _line)
      message(FATAL_ERROR "runner --folds-not-public: ${_name} has no reason beside it")
    endif()
    list(APPEND _names "${_name}")
  endforeach()
  list(SORT _names)
  string(REPLACE "-" "_" _var "${_what}")
  set(_runner_${_var} ${_names})
endforeach()
set(_folds_not_public ${FOLDS_NOT_PUBLIC})
list(SORT _folds_not_public)
if(NOT _runner_folds_not_public STREQUAL _folds_not_public)
  list(APPEND _problems "folds not public in tests/api/CMakeLists.txt: ${_folds_not_public}; in tests/api/runner_arrays.hpp: ${_runner_folds_not_public}")
endif()
string(JSON _fold_count ERROR_VARIABLE _no_folds LENGTH "${_json}" folds)
set(_claim_folds "")
if(NOT _no_folds AND _fold_count GREATER 0)
  math(EXPR _fold_last "${_fold_count} - 1")
  foreach(_i RANGE ${_fold_last})
    string(JSON _f GET "${_json}" folds ${_i} name)
    list(APPEND _claim_folds ${_f})
  endforeach()
endif()
set(_folds_not_checked ${FOLDS_NOT_CHECKED})
foreach(_f IN LISTS _claim_folds)
  set(_n 0)
  foreach(_group fold_list folds_not_public)
    if(_f IN_LIST _runner_${_group})
      math(EXPR _n "${_n} + 1")
    endif()
  endforeach()
  if(_f IN_LIST _folds_not_checked)
    math(EXPR _n "${_n} + 1")
  endif()
  if(NOT _n EQUAL 1)
    list(APPEND _problems "the fold ${_f} is in ${_n} of the runner's fold lists and FOLDS_NOT_CHECKED, not in one")
  endif()
endforeach()
foreach(_f IN LISTS _runner_fold_list _runner_folds_not_public _folds_not_checked)
  if(NOT _f IN_LIST _claim_folds)
    list(APPEND _problems "${_f}, in a list of folds, is not a fold of ${CLAIMS}")
  endif()
endforeach()
list(LENGTH _runner_fold_list _fold_forms_n)
list(LENGTH _runner_folds_not_public _folds_np_n)

set(_packed_message "")
if(PACKED_HEADER)
  file(READ "${PACKED_HEADER}" _text)
  string(REGEX MATCHALL "gen::[a-z0-9_]+\\(" _calls "${_text}")
  set(_called "")
  foreach(_call IN LISTS _calls)
    string(REGEX REPLACE "gen::([a-z0-9_]+)\\(" "\\1" _k "${_call}")
    if(_k IN_LIST _claims AND NOT _k IN_LIST _called)
      list(APPEND _called ${_k})
    endif()
  endforeach()
  list(SORT _called)
  if(NOT _called)
    list(APPEND _problems "${PACKED_HEADER} calls no kernel: the scan is broken")
  endif()
  if(NOT _called STREQUAL _runner_packed_list)
    list(APPEND _problems "the kernels ${PACKED_HEADER} calls: ${_called}; those of the runner's packed forms: ${_runner_packed_list}")
  endif()
  foreach(_k IN LISTS _runner_packed_list)
    if(NOT _k IN_LIST _runner_list)
      list(APPEND _problems "${_k} has a packed form but no scalar public form")
    endif()
  endforeach()
  list(LENGTH _called _c)
  set(_packed_message "; the ${_c} kernels packed.hpp calls are those of the packed forms")
endif()
if(_problems)
  string(JOIN "\n" _problems ${_problems})
  message(FATAL_ERROR "${_problems}")
endif()
list(LENGTH _runner_list _n)
list(LENGTH _runner_internal _m)
list(LENGTH _runner_not_public _p)
list(LENGTH _entry _e)
list(LENGTH _not_checked _q)
message(STATUS "${_n} kernels reached by public forms, ${_m} building blocks, ${_p} entry kernels not public yet "
  "(${_e} entry kernels in all), ${_q} kernels in none of the runner's lists (not cross-checked "
  "or not public yet)${_packed_message}; ${_fold_forms_n} folds reached by the functions on arrays, "
  "${_folds_np_n} with no public caller")
